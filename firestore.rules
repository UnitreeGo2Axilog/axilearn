rules_version = '2';

// AxiLearn security rules.
//
// Principles:
//  - A learner can read and write ONLY their own profile and progress.
//  - Nobody can give themselves the admin role from the browser: the `role`
//    field is fixed at creation and can never be changed client-side. Admins
//    are promoted from the Firebase console.
//  - Course content is world-readable (it is the product) but writable only by
//    admins, ready for the Phase-2 CMS.
//  - Everything not listed is denied.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // On create the role must be 'student'; on update it must stay unchanged.
      allow create: if isOwner(uid) && request.resource.data.role == 'student';
      allow update: if isOwner(uid)
                    && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    match /progress/{docId} {
      allow read, write: if isSignedIn()
                         && request.resource.data.uid == request.auth.uid
                         || (resource != null && isOwner(resource.data.uid))
                         || isAdmin();
    }

    match /tracks/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /modules/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /lessons/{id}  { allow read: if true; allow write: if isAdmin(); }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
