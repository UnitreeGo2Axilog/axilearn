rules_version = '2';

// AxiLearn security rules.
//
// Principles:
//  - A learner can read and write ONLY their own profile and progress.
//  - Nobody can give themselves the admin role from the browser: the `role`
//    field is fixed at creation and can never be changed client-side. Admins
//    are promoted from the Firebase console.
//  - PUBLISHED course content is world-readable (it is the product). DRAFTS are
//    visible only to admins, so the supervisor can write a lesson in the open
//    without it appearing on the site.
//  - All content writes are admin-only.
//  - Everything not listed is denied.
//
// Note on drafts and queries: rules are not filters. Because the read rule
// below inspects `resource.data.status`, any LIST query over /tracks must
// already constrain that field or Firestore rejects it outright. That is
// deliberate -- it is what stops "give me every track" from returning drafts --
// and it is why the server reads published content with a filtered query
// (see src/content/store.ts) rather than a bare collection listing.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isPublished() {
      return resource != null && resource.data.status == 'published';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // On create the role must be 'student'; on update it must stay unchanged.
      // The unchanged-role check is also what makes it safe for a learner to
      // write their own `lastSeenAt` heartbeat, which is how the dashboard
      // knows who is on the platform right now.
      allow create: if isOwner(uid) && request.resource.data.role == 'student';
      // `role` is pinned for EVERYONE, admins included -- promotion stays a
      // console action, exactly as before. `blocked` is pinned for the owner
      // only: an admin can set it, and the person it is set on cannot clear
      // it. A block a learner can lift is not a block, and this field is the
      // only thing standing between a blocked account and the discussion.
      allow update: if request.resource.data.role == resource.data.role
                    && (
                         isAdmin()
                         || (isOwner(uid)
                             && request.resource.data.get('blocked', false)
                                == resource.data.get('blocked', false))
                       );
      allow delete: if isAdmin();
    }

    // One document per completed lesson, id `{uid}__{lessonId}`.
    //
    // A learner may only ever write progress carrying their own uid, so nobody
    // can award themselves someone else's completions -- or forge a classmate's.
    // Admins read everything, for the dashboard, and write nothing.
    match /progress/{docId} {
      allow read: if isSignedIn()
                  && (isAdmin() || (resource != null && resource.data.uid == request.auth.uid));
      allow create, update: if isSignedIn()
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
                    && (isAdmin() || (resource != null && resource.data.uid == request.auth.uid));
    }

    // A teacher's private remark about a learner, one document per uid.
    //
    // Deliberately NOT a field on the user document: a learner can read their
    // own user document, and a note like "struggling, needs a call home" must
    // not be one click away from the person it is about. Admin-only, both ways.
    match /staffNotes/{uid} {
      allow read, write: if isAdmin();
    }

    // One document per solved challenge, id `{uid}__{challengeId}` -- the
    // same shape as /progress, for the same reason: a learner can only ever
    // write their own uid, so nobody can forge a classmate's solve.
    match /challengeProgress/{docId} {
      allow read: if isSignedIn()
                  && (isAdmin() || (resource != null && resource.data.uid == request.auth.uid));
      allow create, update: if isSignedIn()
                            && request.resource.data.uid == request.auth.uid;
      allow delete: if isSignedIn()
                    && (isAdmin() || (resource != null && resource.data.uid == request.auth.uid));
    }

    // A track document holds its own lessons, so one read serves a whole map.
    match /tracks/{trackId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();

      // Long lesson text, kept out of the track document so that document
      // stays well under Firestore's 1 MiB limit. Each body mirrors its
      // lesson's status, so an unpublished lesson's text is admin-only too --
      // checking the parent track instead would cost an extra read per open.
      match /bodies/{lessonId} {
        allow read: if isPublished() || isAdmin();
        allow write: if isAdmin();
      }

      // Standalone practice questions, grouped by difficulty in the UI, each
      // carrying its own status directly (not mirrored from anything else).
      match /challenges/{challengeId} {
        allow read: if isPublished() || isAdmin();
        allow write: if isAdmin();
      }
    }

    // Admin-authored tips and announcements, shown in the bell.
    //
    // Readable by anyone signed in -- nothing here is private, and the bell
    // only exists for a signed-in learner. Same draft rule as course content,
    // with the same consequence: because this rule inspects `status`, a LIST
    // query must constrain that field or Firestore rejects it outright (see
    // src/lib/notifications.ts).
    //
    // WHICH ONES A LEARNER HAS READ is deliberately not stored here. It lives
    // as an array on their own user document, like bookmarks. Per-learner
    // state does not belong in shared content, and keeping it here would mean
    // giving every learner write access to messages they must not be able to
    // edit.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (isPublished() || isAdmin());
      allow write: if isAdmin();
    }

    // A learner writing to their teacher, and the reply.
    //
    // A thread is readable by the learner who owns it and by admins, and by
    // nobody else -- a question like "I don't understand any of this" is not
    // for classmates.
    //
    // AUTHORSHIP IS ENFORCED HERE, which is the reason the messages are
    // separate documents rather than an array on the thread. Rules cannot
    // look inside an array, so with one field holding every message, anyone
    // able to write the thread could append an entry labelled `from: "admin"`
    // and manufacture a reply. As documents, each one is checked as it is
    // created: a learner may only create `from: "student"` in a thread that
    // is theirs, and only an admin may create `from: "admin"`. Messages are
    // never editable or deletable by anyone -- a conversation you can rewrite
    // after the fact is not a record of anything.
    match /contactThreads/{threadId} {
      function ownsThread() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/contactThreads/$(threadId))
          && get(/databases/$(database)/documents/contactThreads/$(threadId)).data.uid == request.auth.uid;
      }

      allow read: if isAdmin()
                  || (isSignedIn() && resource != null && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Both sides update the thread: the flags that drive the unread badges
      // live here, and each side clears its own on opening. The uid can never
      // change hands, so a thread cannot be reassigned to somebody else.
      allow update: if (isAdmin() || (resource != null && resource.data.uid == request.auth.uid))
                    && request.resource.data.uid == resource.data.uid;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if isAdmin() || ownsThread();
        allow create: if (isAdmin() && request.resource.data.from == 'admin')
                      || (ownsThread() && request.resource.data.from == 'student');
        allow update, delete: if false;
      }
    }

    // Homework set by the teacher. Published work is readable by anyone
    // signed in; drafts and every write are admin-only, as with course
    // content.
    match /assignments/{assignmentId} {
      allow read: if isSignedIn() && (isPublished() || isAdmin());
      allow write: if isAdmin();
    }

    // One learner's answer, id `{assignmentId}__{uid}`.
    //
    // THE DEADLINE IS ENFORCED HERE, and it is the only place it means
    // anything. A check in the browser is worth nothing: moving the system
    // clock back is two clicks, and every "you have 24 hours" that lives only
    // in JavaScript is an honour system with a countdown drawn on it.
    //
    // What the rule does NOT do is refuse late work. Locking somebody out at
    // 24h05 loses the thing they spent the evening on, which is a worse
    // outcome than a teacher seeing "late" next to it. So a late submission
    // is accepted -- it simply may not call itself punctual. `late` must
    // equal what the SERVER's clock says, via request.time, so the flag the
    // teacher sees cannot be forged from the client.
    match /submissions/{submissionId} {
      function assignmentOf(id) {
        return get(/databases/$(database)/documents/assignments/$(id)).data;
      }
      function dueAtOf(id) {
        return assignmentOf(id).dueAt;
      }
      function honestlyLate(id) {
        // A null deadline means the teacher turned the limit off: nothing is
        // ever late, so the flag must be false.
        return dueAtOf(id) == null
          ? request.resource.data.late == false
          : request.resource.data.late == (request.time.toMillis() > dueAtOf(id));
      }
      // Feedback belongs to the teacher. A learner resubmitting must carry it
      // through unchanged rather than quietly clearing the reply they got.
      function keepsFeedback() {
        return request.resource.data.get('feedback', '') == resource.data.get('feedback', '');
      }

      allow read: if isAdmin()
                  || (isSignedIn() && resource != null && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && submissionId == request.resource.data.assignmentId + '__' + request.auth.uid
                    && honestlyLate(request.resource.data.assignmentId)
                    && request.resource.data.get('feedback', '') == '';
      allow update: if isAdmin()
                    || (isSignedIn()
                        && resource.data.uid == request.auth.uid
                        && request.resource.data.uid == resource.data.uid
                        && honestlyLate(request.resource.data.assignmentId)
                        && keepsFeedback());
      allow delete: if isAdmin();
    }

    // The shared discussion area: everyone signed in reads it, everyone not
    // blocked writes to it.
    //
    // This is the one genuinely PUBLIC space on the platform, and it is
    // between minors, so what it can and cannot do is worth being exact
    // about:
    //
    //  - A message carries its author's uid, and the rule requires that uid
    //    to be the person writing. Nobody can post as somebody else.
    //  - Messages are never editable. Not by the author, not by an admin.
    //    A public message somebody can silently rewrite after other people
    //    have replied to it is a way to make anyone appear to have said
    //    anything.
    //  - An author may delete their own; an admin may delete any. That is the
    //    moderation the teacher asked for, and it is the minimum a public
    //    space between children needs.
    //  - A blocked account cannot post. `blocked` lives on the user document
    //    where only an admin can set it -- see the users rule above.
    match /discussion/{messageId} {
      function isBlocked() {
        return exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid))
               .data.get('blocked', false) == true;
      }

      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.uid == request.auth.uid
                    && !isBlocked();
      allow update: if false;
      allow delete: if isAdmin()
                    || (isSignedIn() && resource != null
                        && resource.data.uid == request.auth.uid);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
