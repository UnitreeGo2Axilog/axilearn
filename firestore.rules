rules_version = '2';

// AxiLearn security rules.
//
// Principles:
//  - A learner can read and write ONLY their own profile and progress.
//  - Nobody can give themselves the admin role from the browser: the `role`
//    field is fixed at creation and can never be changed client-side. Admins
//    are promoted from the Firebase console.
//  - PUBLISHED course content is world-readable (it is the product). DRAFTS are
//    visible only to admins, so the supervisor can write a lesson in the open
//    without it appearing on the site.
//  - All content writes are admin-only.
//  - Everything not listed is denied.
//
// Note on drafts and queries: rules are not filters. Because the read rule
// below inspects `resource.data.status`, any LIST query over /tracks must
// already constrain that field or Firestore rejects it outright. That is
// deliberate -- it is what stops "give me every track" from returning drafts --
// and it is why the server reads published content with a filtered query
// (see src/content/store.ts) rather than a bare collection listing.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    function isPublished() {
      return resource != null && resource.data.status == 'published';
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      // On create the role must be 'student'; on update it must stay unchanged.
      allow create: if isOwner(uid) && request.resource.data.role == 'student';
      allow update: if isOwner(uid)
                    && request.resource.data.role == resource.data.role;
      allow delete: if isAdmin();
    }

    match /progress/{docId} {
      allow read, write: if isSignedIn()
                         && request.resource.data.uid == request.auth.uid
                         || (resource != null && isOwner(resource.data.uid))
                         || isAdmin();
    }

    // A track document holds its own lessons, so one read serves a whole map.
    match /tracks/{trackId} {
      allow read: if isPublished() || isAdmin();
      allow write: if isAdmin();

      // Long lesson text, kept out of the track document so that document
      // stays well under Firestore's 1 MiB limit. Each body mirrors its
      // lesson's status, so an unpublished lesson's text is admin-only too --
      // checking the parent track instead would cost an extra read per open.
      match /bodies/{lessonId} {
        allow read: if isPublished() || isAdmin();
        allow write: if isAdmin();
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
